# Direct OpenAI usage
OPENAI_API_KEY=sk-proj-...

# Optional OpenRouter usage. If OPENAI_API_KEY is set, the app uses OpenAI first.
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# GitHub token is required only for posting review comments.
# Public PR metadata/diff reads can run without this token.
GITHUB_TOKEN=

# Optional: used in audit_events.reviewer_id for HITL decisions.
GITHUB_USER=